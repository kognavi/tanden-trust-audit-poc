{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyFrozenRuntimeStack",
      "Effect": "Allow",
      "Action": "cloudformation:CreateStack",
      "Resource": "arn:aws:cloudformation:ap-northeast-1:270887329967:stack/tanden-loop017-agentcore-direct/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:TemplateUrl": "https://s3.ap-northeast-1.amazonaws.com/tanden-trust-audit-poc-test-bucket/loop-017/agentcore/TandenEvidenceDemo/initial-create.template.yaml",
          "cloudformation:RoleARN": "arn:aws:iam::270887329967:role/TandenLoop017DirectCfnServiceRole"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::BedrockAgentCore::Runtime"
          ]
        },
        "Null": {
          "cloudformation:ResourceTypes": "false"
        }
      }
    },
    {
      "Sid": "InspectAndDeleteOnlyLoop017Stack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DeleteStack"
      ],
      "Resource": "arn:aws:cloudformation:ap-northeast-1:270887329967:stack/tanden-loop017-agentcore-direct/*"
    },
    {
      "Sid": "ReadOnlyFrozenDeploymentInputs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::tanden-trust-audit-poc-test-bucket/loop-017/agentcore/TandenEvidenceDemo/ea9dee6f3887a16d2362d88cf9ed68a3716bcaacb7b9830e5c3d5e9f3184488c/deployment_package.zip",
        "arn:aws:s3:::tanden-trust-audit-poc-test-bucket/loop-017/agentcore/TandenEvidenceDemo/initial-create.template.yaml"
      ]
    },
    {
      "Sid": "PassOnlyLoop017CloudFormationServiceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::270887329967:role/TandenLoop017DirectCfnServiceRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
